<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/calm_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nama Lokasi"
            android:textColor="@color/calm_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemNoise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/calm_accent_soft"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="78 dB"
            android:textColor="@color/calm_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Kategori: Lalu Lintas"
        android:textColor="@color/calm_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvItemCoords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="GPS: -6.3918, 106.8214"
        android:textColor="@color/calm_text_secondary"
        android:textSize="12sp" />
</LinearLayout>