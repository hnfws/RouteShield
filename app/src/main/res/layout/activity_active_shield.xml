<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calm_bg">

    <!-- 1. Full Screen Zoomed-In Interactive Navigation Map (Sesuai Screenshot Google Maps Navigasi) -->
    <WebView
        android:id="@+id/webViewActiveMap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        tools:ignore="WebViewLayout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Top Floating Turn Banner (Sesuai Screenshot Google Maps) -->
    <LinearLayout
        android:id="@+id/cardTopTurnBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_turn_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTurnIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↰"
            android:textColor="@color/calm_text_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTurnDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150 m"
                android:textColor="@color/calm_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTurnInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Jl. Media 4 (Rute Tenang)"
                android:textColor="@color/calm_text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Sensori Telemetry Badge (BPM & dB over Map) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toBottomOf="@id/cardTopTurnBanner"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvOrbReadout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="64 dB • 78 BPM"
            android:textColor="@color/calm_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hidden compatibility views -->
    <TextView
        android:id="@+id/tvActiveBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. Bottom Navigation ETA & Controls Card (Sesuai Screenshot Google Maps) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Line 1: Duration & Distance ETA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStopShield"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_button"
                android:text="✕"
                android:textColor="@color/calm_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDurationEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 min  🚶"
                    android:textColor="@color/calm_accent"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRemainingDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="950 m • Selesai 3:45 PM"
                    android:textColor="@color/calm_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPlayPauseAudio"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_button"
                android:text="⏸"
                android:textColor="@color/calm_accent"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Line 2: Calming Audio Status Bar -->
        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="🎵  Shield Audio: Brown Noise (Melindungi Sensori)"
            android:textColor="@color/calm_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
