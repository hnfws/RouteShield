<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calm_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Back Button (Sesuai Gambar #6) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_back_button"
                android:text="←"
                android:textColor="@color/calm_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 1: Rate-rata BPM & Total Perjalanan Aman (Sesuai Gambar #6) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_turn_banner"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAvgBpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rate-rata BPM: 64 bpm (Normal)"
                android:textColor="@color/calm_accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSafeTrips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Total Perjalanan Aman: 12"
                android:textColor="@color/calm_accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 2: Frekuensi & Intensitas Stres Mingguan (Sesuai Gambar #6) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_turn_banner"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frekuensi &amp; Intensitas Stres\nMingguan"
                android:textColor="@color/calm_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <!-- Y Axis Labels -->
                <LinearLayout
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="138"
                        android:textColor="@color/calm_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="122"
                        android:textColor="@color/calm_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="60"
                        android:textColor="@color/calm_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="40"
                        android:textColor="@color/calm_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="0"
                        android:textColor="@color/calm_text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- 9 Bars Chart (Sesuai Gambar #6) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="65dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/calm_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="62dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/calm_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/calm_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/calm_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="78dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/calm_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/calm_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/calm_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="102dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/calm_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_weight="1"
                        android:background="@color/calm_accent" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="1       2       3       4       5       6       7       8       9"
                android:textColor="@color/calm_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Dynamic Container for Individual Incident Cards (Sesuai Gambar #6) -->
        <LinearLayout
            android:id="@+id/layoutIncidentCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <!-- Hidden fallback text view for compatibility -->
        <TextView
            android:id="@+id/tvIncidentLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
