<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calm_bg"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="24dp"
            android:background="@color/calm_accent_soft"
            android:gravity="center"
            android:text="🛡️"
            android:textSize="36sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Selamat Datang\ndi Shield"
            android:textColor="@color/calm_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@color/calm_surface"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="14dp"
            android:textColor="@color/calm_text_primary"
            android:textColorHint="@color/calm_text_secondary" />

        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@color/calm_surface"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="@color/calm_text_primary"
            android:textColorHint="@color/calm_text_secondary" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/calm_accent"
            android:text="Masuk"
            android:textColor="@color/calm_bg"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/calm_surface_variant"
            android:text="Buat Akun Baru"
            android:textColor="@color/calm_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:text="atau"
            android:textColor="@color/calm_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLoginGoogle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/calm_surface"
            android:text="G   Masuk dengan Google"
            android:textColor="@color/calm_text_primary" />

        <Button
            android:id="@+id/btnLoginSpotify"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/calm_surface"
            android:text="🎵   Masuk dengan Spotify"
            android:textColor="@color/calm_accent" />

    </LinearLayout>
</ScrollView>